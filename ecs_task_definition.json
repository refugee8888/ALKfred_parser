{
  "family": "alkfred-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::220719767726:role/alkfred_ecs_task_role",
  "taskRoleArn": "arn:aws:iam::220719767726:role/alkfred_ecs_task_role",
  "containerDefinitions": [
    {
      "name": "alkfred",
      "image": "220719767726.dkr.ecr.eu-central-1.amazonaws.com/alkfred:latest",
      "essential": true,
      "command": ["python", "-m", "alkfred.cli.build", "--overwrite", "--oncogene", "ALL", "--source", "civic", "--build-dbt", "--full-refresh"],
      "secrets": [
        {"name": "PG_DSN", "valueFrom": "arn:aws:secretsmanager:eu-central-1:220719767726:secret:alkfred/PG_DSN-a1vvHk"},
        {"name": "BIOPORTAL_API_KEY", "valueFrom": "arn:aws:secretsmanager:eu-central-1:220719767726:secret:alkfred/BIOPORTAL_API_KEY-192bgR"},
        {"name": "DBT_PROJECT_DIR", "valueFrom": "arn:aws:secretsmanager:eu-central-1:220719767726:secret:alkfred/DBT_PROJECT_DIR-t68SQO"},
        {"name": "DBT_HOST", "valueFrom": "arn:aws:secretsmanager:eu-central-1:220719767726:secret:alkfred/DBT_HOST-cXQeRa"},
        {"name": "DBT_USER", "valueFrom": "arn:aws:secretsmanager:eu-central-1:220719767726:secret:alkfred/DBT_USER-yN3DyD"},
        {"name": "DBT_PASSWORD", "valueFrom": "arn:aws:secretsmanager:eu-central-1:220719767726:secret:alkfred/DBT_PASSWORD-QK2JoP"},
        {"name": "DBT_DBNAME", "valueFrom": "arn:aws:secretsmanager:eu-central-1:220719767726:secret:alkfred/DBT_DBNAME-QcYPEY"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/alkfred",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
