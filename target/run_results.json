  group by\n        b.ncit_id,\n        b.doid\n)\n\nselect\n    agg.ncit_id,\n    agg.doid,\n    agg.n_resistant_evidence,\n    agg.n_sensitive_evidence,\n    agg.n_total_evidence,\n    agg.n_resistant_variants,\n    agg.n_sensitive_variants,\n    case\n        when agg.n_total_evidence > 0\n            then agg.n_resistant_evidence::double precision\n                 / nullif(agg.n_total_evidence, 0)\n        else null\n    end as resistance_rate\nfrom agg", "relation_name": "\"alkfred\".\"public\".\"fact_therapy_disease\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-12-17T17:38:53.692721Z", "completed_at": "2025-12-17T17:38:53.699738Z"}, {"name": "execute", "started_at": "2025-12-17T17:38:53.700960Z", "completed_at": "2025-12-17T17:38:53.776253Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.08612728118896484, "adapter_response": {"_message": "SELECT 603", "code": "SELECT", "rows_affected": 603}, "message": "SELECT 603", "failures": null, "unique_id": "model.alkfred_dbt.fact_variant_therapy_daily", "compiled": true, "compiled_code": "\n\nwith base as (\n\n    select variant_id,\n           ncit_id, \n           doid,\n           created_at_utc::date as activity_date,\n           significance\n    from \"alkfred\".\"public\".\"stg_fact_evidence\"\n    where ncit_id is not null\n),\nagg as (\n    select\n        b.variant_id,\n        b.ncit_id,\n        b.doid,\n        b.activity_date,\n        count(case when b.significance = 'RESISTANCE' then 1 end) as n_resistant,\n        count(case when b.significance = 'SENSITIVITY' then 1 end) as n_sensitive,\n        count(*)::int as n_total\n    from base as b\n    group by b.variant_id, b.ncit_id, b.doid, b.activity_date\n)\n\nselect \n    agg.variant_id,\n    agg.ncit_id,\n    agg.doid,\n    agg.activity_date,\n    agg.n_resistant,\n    agg.n_sensitive,\n    agg.n_total,\n    case \n        when agg.n_total>0\n            then agg.n_resistant::double precision / agg.n_total\n        else null\n    end as resistance_rate\nfrom agg", "relation_name": "\"alkfred\".\"public\".\"fact_variant_therapy_daily\"", "batch_results": null}], "elapsed_time": 0.3665757179260254, "args": {"use_colors_file": true, "favor_state": false, "which": "run", "quiet": false, "macro_debugging": false, "printer_width": 80, "use_fast_test_edges": false, "write_json": true, "introspect": true, "require_nested_cumulative_type_params": false, "partial_parse_file_diff": true, "cache_selected_only": false, "print": true, "require_batched_execution_for_custom_microbatch_strategy": false, "log_path": "/app/logs", "invocation_command": "dbt run", "indirect_selection": "eager", "version_check": true, "require_generic_test_arguments_property": true, "exclude": [], "log_level_file": "debug", "state_modified_compare_vars": false, "select": [], "validate_macro_args": false, "log_level": "info", "profiles_dir": "/home/appuser/.dbt", "log_format": "default", "require_explicit_package_overrides_for_builtin_materializations": true, "upload_to_artifacts_ingest_api": false, "static_parser": true, "defer": false, "send_anonymous_usage_stats": true, "require_yaml_configuration_for_mf_time_spines": false, "require_resource_names_without_spaces": true, "log_file_max_bytes": 10485760, "empty": false, "vars": {}, "warn_error_options": {"error": [], "warn": [], "silence": []}, "use_colors": true, "partial_parse": true, "state_modified_compare_more_unrendered_values": false, "skip_nodes_if_on_run_start_fails": false, "source_freshness_run_project_hooks": true, "populate_cache": true, "show_all_deprecations": false, "project_dir": "/app", "require_all_warnings_handled_by_warn_error": false, "show_resource_report": false, "log_format_file": "debug", "strict_mode": false}}